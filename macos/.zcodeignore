# ══════════════════════════════════════════════════════════════
# 密钥与本地配置 —— 最容易误提交的一类，放最前面
# ══════════════════════════════════════════════════════════════
.env
.env.*
!.env.example
*.key
*.pem
*.p12
config.local.json

# ══════════════════════════════════════════════════════════════
# 运行产物 —— 可能包含私人聊天内容
# ══════════════════════════════════════════════════════════════
results/
debug-captures/
.ocr-cache/
*.log
*.png
*.jpg
!docs/**/*.png

# ══════════════════════════════════════════════════════════════
# 构建产物
# ══════════════════════════════════════════════════════════════
*.app/
*.icns
*.iconset/
build/
dist/
wheels/
*.egg-info/

# ══════════════════════════════════════════════════════════════
# Python
# ══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ══════════════════════════════════════════════════════════════
# macOS
# ══════════════════════════════════════════════════════════════
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
*.swp
*~

# ══════════════════════════════════════════════════════════════
# 编辑器 / IDE
# ══════════════════════════════════════════════════════════════
.idea/
.vscode/
*.sublime-*
.history/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
